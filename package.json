{
  "name": "reflexrun",
  "version": "0.3.0",
  "description": "Procedural memory for Computer Use: explore once, replay familiar work, delegate changes to the original agent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "reflexrun": "dist/src/cli.js"
  },
  "exports": {
    "./proxy": {
      "types": "./dist/src/proxy/index.d.ts",
      "import": "./dist/src/proxy/index.js"
    },
    "./memory": {
      "types": "./dist/src/memory/index.d.ts",
      "import": "./dist/src/memory/index.js"
    },
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "skills",
    "scripts/setup.mjs",
    "scripts/demo.mjs",
    "docs/playground",
    "docs/logo.svg",
    "docs/badges",
    "docs/demo.mp4",
    "docs/demo-poster.jpg",
    "benchmarks/showcase.json",
    "benchmarks/capabilities.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check": "npm run format:check && tsc --noEmit",
    "format": "prettier --write src scripts test docs/playground README*.md package.json tsconfig.json .github skills --ignore-unknown",
    "format:check": "prettier --check src scripts test docs/playground README*.md package.json tsconfig.json .github skills --ignore-unknown",
    "test": "node scripts/test.mjs",
    "test:core": "tsx --test test/core.test.ts test/memory-store.test.ts test/gateway.test.ts test/execution.test.ts test/capabilities.test.ts",
    "demo": "node scripts/demo.mjs",
    "setup:codex": "node scripts/setup.mjs",
    "prepare:desktop": "npm run build && node scripts/prepare-desktop.mjs",
    "release:desktop": "npm run prepare:desktop && node scripts/release-desktop.mjs",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "bench:batch": "tsx scripts/benchmark-batch.ts",
    "bench:live": "tsx scripts/benchmark-live.ts",
    "prepack": "npm run build"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "proseWrap": "preserve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.84",
    "@types/node": "^20.19.43",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
